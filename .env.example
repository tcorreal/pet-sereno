# Supabase. La credencial de aplicación es privada y solo vive en el servidor.
# El mismo SUPABASE_URL/SUPABASE_APP_TOKEN también los usa app/api/chat/route.ts
# para reenviar la sesión del sitio a la Edge Function `chat-agent`
# (ver supabase/functions/chat-agent) — el widget de chat le pega a esa ruta,
# nunca directo a Supabase, porque la cookie de sesión es httpOnly y de este
# mismo origen. El agente de IA (NVIDIA, etc.) vive fuera de este repo, como
# secret de esa Edge Function.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_APP_TOKEN=

# Correos del equipo con acceso a /admin (separados por coma). No hay ningún
# rol en la base de datos: cualquier correo que no esté en esta lista, aunque
# haya iniciado sesión como cliente normal, recibe 403/redirect fuera de /admin.
ADMIN_EMAILS=

# Proveedor de correo. El endpoint recibe SEND_EMAIL y responde { messageId }.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM_NAME=Pet Sereno

# Solo para probar localmente sin escribir en la base de datos real.
LOCAL_DEMO_MODE=false

# Identidad exclusiva para desarrollo local. Nunca se usa en producción.
LOCAL_TEST_AUTH=false
LOCAL_TEST_USER_ID=local-pet-sereno-test-user
LOCAL_TEST_USER_EMAIL=pruebas.local@petsereno.test
LOCAL_TEST_USER_NAME=Pruebas Pet Sereno
