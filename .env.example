# Supabase. La credencial de aplicación es privada y solo vive en el servidor.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_APP_TOKEN=

# Mismos valores que arriba, pero expuestos al navegador (NEXT_PUBLIC_) para
# que el widget de chat llame directo a la Edge Function `chat-agent` del
# proyecto de Supabase. La publishable key ya está pensada para ser pública.
# El agente de IA (NVIDIA, etc.) vive fuera de este repo, como secret de esa
# Edge Function — ver supabase/functions/chat-agent.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Proveedor de correo. El endpoint recibe SEND_EMAIL y responde { messageId }.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM_NAME=Pet Sereno

# Solo para probar localmente sin escribir en la base de datos real.
LOCAL_DEMO_MODE=false
